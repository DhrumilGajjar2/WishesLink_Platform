# ==========================================
# Digital Wishing Wall - Environment Config
# ==========================================
#
# NOTE: The app works 100% out of the box locally WITHOUT these keys!
# It will use the local JSON store in .data/ and local file uploads in public/uploads/.
#
# When you are ready to deploy to production (Vercel + Supabase):
# 1. Create a project at https://supabase.com
# 2. Run the provided SQL migration in Supabase SQL Editor
# 3. Create a public storage bucket named "wishing-wall-photos"
# 4. Fill in the credentials below:

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key for admin-level operations (if needed)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
